# evo-control: udev rules for Audient EVO 8
# Installed by `sudo evo-control install-driver`
#
# Grants user access to /dev/evo8 and triggers the apply-preset service
# on device connect / system boot.

ACTION=="add", SUBSYSTEM=="misc", KERNEL=="evo8", MODE="0660", GROUP="audio", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="evo-control-apply.service"
